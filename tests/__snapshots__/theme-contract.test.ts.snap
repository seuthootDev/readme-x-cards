exports[`sunset theme > renders a post card with metrics and media 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="450" height="204" viewBox="0 0 450 204" role="img" aria-label="Post by @jack on X" font-family="'Trebuchet MS','Segoe UI',Helvetica,Arial,sans-serif">
<title>Post by @jack on X</title>
<defs>
<clipPath id="card"><rect width="450" height="204" rx="16"/></clipPath>
<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#140a2e"/><stop offset="1" stop-color="#4b1260"/></linearGradient>
<linearGradient id="sun" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd36e"/><stop offset="1" stop-color="#ff4f8b"/></linearGradient>
<mask id="stripes"><rect width="450" height="204" fill="#ffffff"/><rect x="0" y="128.7" width="450" height="1.5" fill="#000000"/><rect x="0" y="134.5" width="450" height="2.6" fill="#000000"/><rect x="0" y="142.7" width="450" height="3.7" fill="#000000"/><rect x="0" y="153.3" width="450" height="4.8" fill="#000000"/><rect x="0" y="166.3" width="450" height="5.9" fill="#000000"/><rect x="0" y="181.7" width="450" height="7.0" fill="#000000"/></mask>
</defs>
<g clip-path="url(#card)">
<rect width="450" height="204" fill="url(#sky)"/>
<circle cx="392" cy="154" r="46" fill="url(#sun)" mask="url(#stripes)"/>
<rect y="154" width="450" height="50" fill="#12061f"/>
<g stroke="#ff4f8b" stroke-opacity=".4" stroke-width="1"><line x1="0" x2="450" y1="158.0" y2="158.0"/><line x1="0" x2="450" y1="167.0" y2="167.0"/><line x1="0" x2="450" y1="179.9" y2="179.9"/><line x1="0" x2="450" y1="196.2" y2="196.2"/><line x1="27" y1="154" x2="-765" y2="204"/><line x1="49" y1="154" x2="-655" y2="204"/><line x1="71" y1="154" x2="-545" y2="204"/><line x1="93" y1="154" x2="-435" y2="204"/><line x1="115" y1="154" x2="-325" y2="204"/><line x1="137" y1="154" x2="-215" y2="204"/><line x1="159" y1="154" x2="-105" y2="204"/><line x1="181" y1="154" x2="5" y2="204"/><line x1="203" y1="154" x2="115" y2="204"/><line x1="225" y1="154" x2="225" y2="204"/><line x1="247" y1="154" x2="335" y2="204"/><line x1="269" y1="154" x2="445" y2="204"/><line x1="291" y1="154" x2="555" y2="204"/><line x1="313" y1="154" x2="665" y2="204"/><line x1="335" y1="154" x2="775" y2="204"/><line x1="357" y1="154" x2="885" y2="204"/><line x1="379" y1="154" x2="995" y2="204"/><line x1="401" y1="154" x2="1105" y2="204"/><line x1="423" y1="154" x2="1215" y2="204"/></g>
<line x1="0" x2="450" y1="154" y2="154" stroke="#ff8fb8" stroke-width="1.5"/>
</g>
<circle cx="44" cy="44" r="21" fill="none" stroke="#5ef2ff" stroke-width="2"/>
<clipPath id="avatar"><circle cx="44" cy="44" r="18"/></clipPath>
<image href="data:image/jpeg;base64,AQID" x="26" y="26" width="36" height="36" clip-path="url(#avatar)"/>
<text x="74" y="40" font-size="15" font-weight="700" font-style="italic" fill="#ffffff">jack</text>
<g transform="translate(119 35)"><circle r="8" fill="#5ef2ff"/><path d="M-3.5 0.2 L-1 2.7 L3.8 -2.4" fill="none" stroke="#140a2e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></g>
<text x="74" y="59" font-size="13" fill="#ffb3d1">@jack · Mar 21, 2006</text>
<text class="body" x="24" y="100" font-size="16" fill="#ffffff">just setting up my twttr</text>
<text x="24" y="122" font-size="12" fill="#ffb3d1">+ 2 photos · 1 video</text>
<text x="24" y="186" font-size="10" letter-spacing="1" fill="#ffb3d1"><tspan font-size="14" font-weight="700" letter-spacing="0" fill="#5ef2ff">18.1K</tspan> REPLIES</text>
<text x="136" y="186" font-size="10" letter-spacing="1" fill="#ffb3d1"><tspan font-size="14" font-weight="700" letter-spacing="0" fill="#5ef2ff">124.7K</tspan> REPOSTS</text>
<text x="256" y="186" font-size="10" letter-spacing="1" fill="#ffb3d1"><tspan font-size="14" font-weight="700" letter-spacing="0" fill="#5ef2ff">309.4K</tspan> LIKES</text>
<text x="360" y="186" font-size="10" letter-spacing="1" fill="#ffb3d1"><tspan font-size="14" font-weight="700" letter-spacing="0" fill="#5ef2ff">1.2M</tspan> VIEWS</text>
</svg>"
`;


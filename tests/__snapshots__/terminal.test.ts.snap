exports[`terminal theme > renders a post card 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="450" height="194" viewBox="0 0 450 194" role="img" aria-label="Post by @jack on X" font-family="'JetBrains Mono','SF Mono',Consolas,Menlo,monospace">
<title>Post by @jack on X</title>
<rect x="0.5" y="0.5" width="449" height="193" rx="10" fill="#0d1117" stroke="#30363d"/>
<path d="M0.5 30.5 V10.5 a10 10 0 0 1 10 -10 H439.5 a10 10 0 0 1 10 10 V30.5 Z" fill="#161b22"/>
<line x1="0.5" y1="30.5" x2="449.5" y2="30.5" stroke="#30363d"/>
<circle cx="18" cy="16" r="5" fill="#ff5f57"/><circle cx="34" cy="16" r="5" fill="#febc2e"/><circle cx="50" cy="16" r="5" fill="#28c840"/>
<text x="225" y="20" font-size="11" fill="#8b949e" text-anchor="middle">post/20</text>
<clipPath id="avatar"><rect x="24" y="48" width="32" height="32" rx="6"/></clipPath>
<image href="data:image/jpeg;base64,AQID" x="24" y="48" width="32" height="32" clip-path="url(#avatar)"/>
<text x="68" y="61" font-size="13" font-weight="700" fill="#e6edf3">jack<tspan fill="#3fb950"> ✓</tspan> <tspan font-weight="400" fill="#79c0ff">@jack</tspan></text>
<text x="68" y="78" font-size="11" fill="#8b949e">// 2006-03-21</text>
<text class="body" x="24" y="112" font-size="14" fill="#a5d6ff">&quot;just setting up my twttr&quot;</text>
<text x="24" y="134" font-size="12" fill="#8b949e">[2 photos · 1 video]</text>
<text x="24" y="168" font-size="12" fill="#8b949e" xml:space="preserve">replies <tspan fill="#ffa657">18.1K</tspan>  reposts <tspan fill="#ffa657">124.7K</tspan>  likes <tspan fill="#ffa657">309.4K</tspan>  views <tspan fill="#ffa657">1.2M</tspan></text>
</svg>"
`;


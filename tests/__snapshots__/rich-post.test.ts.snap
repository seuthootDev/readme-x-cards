exports[`sunset rich post > stays a valid, self-contained SVG 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="450" height="484" viewBox="0 0 450 484" role="img" aria-label="Post by @jack on X" font-family="'Trebuchet MS','Segoe UI',Helvetica,Arial,sans-serif">
<title>Post by @jack on X</title>
<defs>
<clipPath id="card"><rect width="450" height="484" rx="16"/></clipPath>
<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#140a2e"/><stop offset="1" stop-color="#4b1260"/></linearGradient>
<linearGradient id="sun" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd36e"/><stop offset="1" stop-color="#ff4f8b"/></linearGradient>
<mask id="stripes"><rect width="450" height="484" fill="#ffffff"/><rect x="0" y="408.7" width="450" height="1.5" fill="#000000"/><rect x="0" y="414.5" width="450" height="2.6" fill="#000000"/><rect x="0" y="422.7" width="450" height="3.7" fill="#000000"/><rect x="0" y="433.3" width="450" height="4.8" fill="#000000"/><rect x="0" y="446.3" width="450" height="5.9" fill="#000000"/><rect x="0" y="461.7" width="450" height="7.0" fill="#000000"/></mask>
</defs>
<g clip-path="url(#card)">
<rect width="450" height="484" fill="url(#sky)"/>
